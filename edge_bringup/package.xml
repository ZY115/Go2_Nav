<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>edge_bringup</name>
  <version>0.1.0</version>
  <description>Bringup package for the Edge system with unified namespace</description>
  <maintainer email="yihao.cai@wayne.edu">Yihao Cai</maintainer>
  <license>Apache-2.0</license>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>edge_drl_student</exec_depend>
  <exec_depend>edge_phy_teacher</exec_depend>
  <exec_depend>edge_trigger</exec_depend>
  <exec_depend>edge_gazebo</exec_depend>
  <exec_depend>edge_quadruped_controller</exec_depend>
  <exec_depend>indicator_led_driver</exec_depend>
  <exec_depend>edge_nav_bringup</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
